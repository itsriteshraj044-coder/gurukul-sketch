# Public site URL (used for canonical links + sitemap.xml). No trailing slash.
VITE_SITE_URL=

# Optional: an HTTPS endpoint that accepts enquiries as multipart/form-data.
# Leave empty to use the WhatsApp hand-off fallback. See README > "Form submissions".
# Never put secrets here — every VITE_* value is visible in the browser bundle.
VITE_ENQUIRY_ENDPOINT=
